# Application queries: use the Neon pooled connection string (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"

# Prisma migrations and schema operations: use the Neon direct connection string (no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/DB?sslmode=require"

# Google OAuth (required for sign-in)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Add this authorized redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
