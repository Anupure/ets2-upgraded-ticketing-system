# Local development MUST use the Neon TEST branch.
# The db:test:* scripts refuse to run unless this is exactly "test".
DB_ENVIRONMENT="test"
# Exact direct Neon hostname for the TEST branch (without -pooler.).
DB_EXPECTED_BRANCH_HOST="YOUR-TEST-BRANCH.neon.tech"

# Application queries: use the Neon TEST pooled connection string (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-TEST-NEON-POOLER-HOST/DB?sslmode=require"

# Prisma migrations and schema operations: use the Neon TEST direct connection string (no -pooler).
# It must point to the same Neon branch and database as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-TEST-NEON-DIRECT-HOST/DB?sslmode=require"

# Google OAuth (required for sign-in)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Add this authorized redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
