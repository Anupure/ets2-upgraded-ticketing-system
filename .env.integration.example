# Dedicated Neon integration-test database only.
# Never use the production database or the populated application TEST branch here.
DB_ENVIRONMENT="test"
# Exact direct hostname (without -pooler), copied from Neon with pooling disabled.
DB_EXPECTED_BRANCH_HOST="YOUR-INTEGRATION-BRANCH.neon.tech"

# Pooled connection URL for the dedicated integration database.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-INTEGRATION-POOLER-HOST/DB?sslmode=require"

# Direct connection URL for the same branch and database.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-INTEGRATION-DIRECT-HOST/DB?sslmode=require"
